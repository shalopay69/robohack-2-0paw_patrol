<?xml version="1.0"?>
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3">
      <PipelineSequence>
        <RateController hz="1.0">
          <Fallback>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="NavFn"/>
          </Fallback>
        </RateController>
        <Fallback>
          <FollowPath path="{path}" controller_id="FollowPath" goal_checker_id="goal_checker"/>
          <FollowPath path="{path}" controller_id="FollowNarrowPath" goal_checker_id="goal_checker"/>
        </Fallback>
      </PipelineSequence>
      <RoundRobin>
        <Wait wait_duration="1"/>
        <DriveOnHeading dist_to_travel="0.20" speed="0.08" time_allowance="14"/>
        <BackUp backup_dist="0.20" backup_speed="0.08" time_allowance="14"/>
      </RoundRobin>
    </RecoveryNode>
  </BehaviorTree>
</root>
